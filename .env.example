# Hackathon keys work with the hackathon host only.
QLOO_API_KEY=replace-with-your-qloo-hackathon-api-key
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Optional: enables model-generated strategy and concept comparisons.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra

# Optional adaptive bot challenge. Set both keys to challenge visitors after the in-memory burst limit.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Set to false to pause all live analysis without a deployment.
LAUNCHLENS_ANALYSIS_ENABLED=true

# Optional secret salt for anonymous in-memory rate-limit identifiers.
RATE_LIMIT_SALT=
