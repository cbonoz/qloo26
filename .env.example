# Hackathon keys work with the hackathon host only.
QLOO_API_KEY=replace-with-your-qloo-hackathon-api-key
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Optional: enables xAI/Grok-generated strategy and concept comparisons.
XAI_API_KEY=
XAI_MODEL=grok-4.7

# Set to false to pause all live analysis without a deployment.
LAUNCHLENS_ANALYSIS_ENABLED=true

# Optional shared daily counter across server instances. Strongly recommended
# for any public deployment. Keep this server-only.
# Get a private app key from https://keyvalue.immanuel.co/api/KeyVal/GetAppKey
KEYVALUE_APP_KEY=

# Daily abuse/cost caps. Defaults are built in:
# 3 analyses and 10 reference suggestions per visitor, with a shared global
# cap of 50 for each per UTC day. Uncomment only to override.
# LAUNCHLENS_DAILY_ANALYSES_PER_VISITOR=3
# LAUNCHLENS_DAILY_SUGGESTIONS_PER_VISITOR=10
# LAUNCHLENS_DAILY_ANALYSES_GLOBAL=50
# LAUNCHLENS_DAILY_SUGGESTIONS_GLOBAL=50

# Optional stable secret salt for anonymous visitor identifiers; if omitted,
# KEYVALUE_APP_KEY (or QLOO_API_KEY when the shared store is disabled) is used.
RATE_LIMIT_SALT=
