# Hackathon keys work with the hackathon host only.
QLOO_API_KEY=replace-with-your-qloo-hackathon-api-key
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Optional: enables xAI/Grok-generated strategy and concept comparisons.
XAI_API_KEY=
XAI_MODEL=grok-4.7

# Set to false to pause all live analysis without a deployment.
LAUNCHLENS_ANALYSIS_ENABLED=true

# Optional shared daily counter across server instances. Keep this server-only.
# Get a private app key from https://keyvalue.immanuel.co/api/KeyVal/GetAppKey
KEYVALUE_APP_KEY=

# Optional stable secret salt for anonymous visitor identifiers; if omitted,
# KEYVALUE_APP_KEY (or QLOO_API_KEY when the shared store is disabled) is used.
RATE_LIMIT_SALT=
